AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=
FENCECOACH_KNOWLEDGE_DIR=knowledge
FENCECOACH_DB_PATH=data/fencecoach.sqlite3
FENCECOACH_VIDEO_DIR=data/videos
FENCECOACH_POSE_MODEL=models/pose_landmarker_full.task
FENCECOACH_VIDEO_WORKER=true
FENCECOACH_CHAT_PROVIDER=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
# Empty = SQLite. PostgreSQL URL enables independent API and worker replicas.
FENCECOACH_DATABASE_URL=
FENCECOACH_WORKER_CONCURRENCY=1
FENCECOACH_QUEUE_LIMIT=100
FENCECOACH_GESTURE_MODEL=models/gestures.json
FENCECOACH_COACHING_WORKER=true
FENCECOACH_COACHING_CONCURRENCY=1
# Optional existing private bucket. Standard AWS credential configuration is used.
FENCECOACH_S3_BUCKET=
FENCECOACH_S3_PREFIX=fencecoach
FENCECOACH_S3_ENDPOINT=
